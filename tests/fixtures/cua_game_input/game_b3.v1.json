    "request_authorization_deadline": "original absolute cutoff; never renew",
    "cancel_or_expiry": "owned UP cleanup only; no new DOWN/MOVE",
    "cleanup_unknown": "retain owner/isolate session; no next mutation or claimed UP ACK",
    "original_final_fence": "same exact immutable task/session/native birth/geometry/DPI; actual foreground/unobscured/nonminimized/desktop/interrupt",
    "slow_proof": "fresh cancellation/expiry/clock after slow proof immediately before DOWN/MOVE",
    "queue_owner": "same worker retains physical-input queue until actual cleanup terminal; future drop never releases it early",
    "cleanup": "actual inserted DOWN prefix/possible-down uncertainty; reverse per-key release attempts <=4; no blind retries; truthful unknown"
