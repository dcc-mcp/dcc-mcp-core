                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "input_kind",
                    "secret_input",
                    "authorization_category"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_window_frame"
                    },
                    "input_kind": {
                      "const": "window_state"
                    },
                    "secret_input": {
                      "const": false
                    },
                    "authorization_category": {
                      "const": "window_state"
                    },
                    "browser_origin": {
                      "type": "null"
                    }
                  }
                },
                {
                  "title": "Temporary passive exact-root capture preparation",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "input_kind",
                    "secret_input",
                    "authorization_category"
                  ],
                  "properties": {
                    "action": {
                      "const": "capture_preparation_begin"
                    },
                    "input_kind": {
                      "const": "window_state"
                    },
                    "secret_input": {
                      "const": false
                    },
                    "authorization_category": {
                      "const": "window_state"
                    },
                    "browser_origin": {
                      "type": "null"
                    }
                  }
                },
                {
                  "title": "Observation-bound foreground pixel input",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "input_kind",
                    "secret_input",
                    "authorization_category"
                  ],
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
