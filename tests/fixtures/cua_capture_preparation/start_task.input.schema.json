{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_label",
    "surface",
    "allowed_methods",
    "allowed_actions"
  ],
  "oneOf": [
    {
      "required": [
        "target_process_id",
        "target_window_handle"
      ],
      "not": {
        "required": [
          "owned_browser_launch"
        ]
      }
    },
    {
      "required": [
        "owned_browser_launch"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "target_process_id"
            ]
          },
          {
            "required": [
              "target_window_handle"
            ]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
