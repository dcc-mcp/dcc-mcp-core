{"_vrs": {"version": 1}, "trace_id": "core-any-dcc-skill-sidecar-dispatch", "title": "A Maya sidecar must execute tools loaded from a dcc:any skill", "skip_preflight": {"http": {"method": "POST", "path": "/v1/search", "json": {"kind": "skill", "query": "dna-io", "dcc_type": "maya", "limit": 1}}, "skip_when": {"json_pointer": "/total", "equals": 0}}}
{"id": "load_any_dcc_skill", "http": {"method": "POST", "path": "/v1/load_skill", "json": {"skill_name": "dna-io", "dcc_type": "maya"}}, "expect": {"status": 200, "body_contains": "dna_session"}}
{"id": "find_any_dcc_tool", "http": {"method": "POST", "path": "/v1/search", "json": {"query": "dna_session", "dcc_type": "maya", "loaded_only": true, "limit": 1}}, "expect": {"status": 200, "body_contains": "dna_session"}, "capture": {"json_pointer": "/hits/0/tool_slug", "as": "slug"}}
{"id": "call_any_dcc_tool_through_sidecar", "http": {"method": "POST", "path": "/v1/call", "json": {"tool_slug": "{{capture:slug}}", "arguments": {}}}, "expect": {"status": 200, "body_contains": "success"}}
