tests/_cache/

# Temporary / commit message files
*.tmp
.commit-msg*
.git-commit-msg*
_commit_msg_*.txt
memory/

/.show_checks.py
/.checks.json
coverage/

# Pipeline benchmark report (generated by scripts/bench_pipeline_report.py)
pipeline-bench.json

# Skills benchmark trend series (derived; carried between CI runs as a workflow
# artifact, never committed — a weekly commit here would feed release-please and
# start the self-amplifying release loop).
benchmarks/skills/trend-history.json
skills-bench-trend.json
skills-bench-trend.md
skills-bench-alerts.json

