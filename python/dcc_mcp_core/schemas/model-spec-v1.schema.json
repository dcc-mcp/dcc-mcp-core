{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcc-mcp.github.io/dcc-mcp-core/schemas/model-spec-v1.schema.json",
  "title": "DCC-MCP Modeling Spec v1",
  "description": "Strict, declarative expectations for normalized cross-DCC modeling state.",
  "type": "object",
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["parts", "hierarchy", "materials", "uv_coverage", "non_manifold", "euler"]
      }
    },
    "required_parts": {"type": "array", "items": {"type": "string"}},
    "required_hierarchy": {"type": "array", "items": {"type": "string"}},
    "required_materials": {"type": "array", "items": {"type": "string"}},
    "min_uv_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "allow_non_manifold": {"type": "boolean"},
    "euler_max_abs_degrees": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
