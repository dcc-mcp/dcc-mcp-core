{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcc-mcp.github.io/dcc-mcp-core/schemas/eval-set-v1.schema.json",
  "title": "DCC-MCP offline evaluation set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "set_version": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "title", "invocation", "tags"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "invocation": {"type": "object"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
