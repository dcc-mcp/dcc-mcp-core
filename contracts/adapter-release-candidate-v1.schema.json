{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcc-mcp.dev/contracts/adapter-release-candidate-v1.schema.json",
  "title": "Review-only adapter release candidates v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "candidate_only"
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "selection": {
            "enum": [
              "explicit_version",
              "observed_latest"
            ]
          },
          "status": {
            "enum": [
              "blocked",
              "review_required"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_entry_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repository": {
            "type": "string"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "metadata_url": {
            "type": "string"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "platform_tag": {
                "const": "py3-none-any"
              }
            },
            "required": [
              "url",
              "sha256",
              "size",
              "platform_tag"
            ]
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requires_python": {
                "type": "string"
              },
              "requires_dist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "entry_points": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "core_bounds": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "declaration": {
                        "type": "string"
                      },
                      "lower": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "upper": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "codes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "suggestion": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ok": {
                        "type": "boolean"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "declaration",
                      "lower",
                      "upper",
                      "codes",
                      "suggestion",
                      "ok",
                      "message"
                    ]
                  }
                ]
              },
              "packaged_compatibility": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "document": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "document"
                    ]
                  }
                ]
              },
              "host_status": {
                "const": "not_checked"
              },
              "native_extras_status": {
                "const": "not_checked"
              }
            },
            "required": [
              "requires_python",
              "requires_dist",
              "entry_points",
              "core_bounds",
              "packaged_compatibility",
              "host_status",
              "native_extras_status"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "verification": {
                "const": "not_checked"
              }
            },
            "required": [
              "url",
              "verification"
            ]
          },
          "changes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "before": {},
                "after": {}
              },
              "required": [
                "before",
                "after"
              ]
            }
          },
          "catalog_entry": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "version",
          "selection",
          "status",
          "blockers",
          "approved_entry_sha256",
          "repository",
          "source_commit",
          "metadata_url",
          "artifact",
          "compatibility",
          "provenance",
          "changes",
          "catalog_entry"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "properties": {
                "blockers": {
                  "minItems": 1
                },
                "catalog_entry": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "blockers": {
                  "maxItems": 0
                },
                "catalog_entry": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "authority",
    "observed_at",
    "index_sha256",
    "approved_catalog_sha256",
    "candidates"
  ]
}
